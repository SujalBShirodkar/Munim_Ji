# Application Environment
ENVIRONMENT=development
ALLOW_PRODUCTION=false
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=munim_ji

# Security & Auth
JWT_SECRET=munim_ji_super_secret_jwt_key_2026_hackathon_demo
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# LLM (Groq) — use model IDs available on your Groq account
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Voice (Deepgram STT & Cartesia TTS)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_MODEL=sonic-3.6

# Paytm Payment Gateway (Staging / Sandbox)
# Options: 'mock' (offline UI development/demo) or 'sandbox' (real Paytm staging)
PAYMENTS_MODE=mock
PAYTM_MID=YOUR_STAGING_MID
PAYTM_MERCHANT_KEY=YOUR_STAGING_KEY
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_HOST=https://securegw-stage.paytm.in
PAYTM_CALLBACK_URL=http://localhost:8000/payments/paytm/callback
PAYTM_WEBHOOK_URL=http://localhost:8000/payments/paytm/webhook

# Frontend Client Public Config
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_PAYTM_HOST=https://securegw-stage.paytm.in
NEXT_PUBLIC_PAYMENTS_MODE=mock

